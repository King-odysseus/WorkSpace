{
  "name": "zuricopilot-desktop",
  "productName": "ZuriCopilot",
  "version": "0.0.0",
  "private": true,
  "description": "ZuriCopilot desktop spike. Self-contained: the web app's root build never reads this folder.",
  "main": "electron/main.js",
  "scripts": {
    "start": "electron .",
    "start:smoke": "electron . --smoke-test",
    "probe:smoke": "electron . --probe-view-smoke",
    "check": "node --test features/copilot"
  },
  "devDependencies": {
    "electron": "^45.3.2"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
