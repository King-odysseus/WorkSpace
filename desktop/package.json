{
  "name": "zuricopilot-desktop",
  "productName": "ZuriCopilot",
  "version": "0.0.0",
  "private": true,
  "description": "ZuriCopilot desktop spike. Self-contained: the web app's root build never reads this folder.",
  "author": "Zuri",
  "main": "electron/main.js",
  "scripts": {
    "start": "electron .",
    "start:smoke": "electron . --smoke-test",
    "probe:smoke": "electron . --probe-view-smoke",
    "build:main": "node scripts/build-main.mjs",
    "typecheck": "tsc --noEmit --project tsconfig.json && tsc --noEmit --project tsconfig.renderer.json",
    "check": "npm run typecheck && npm run build:main && node scripts/run-tests.mjs",
    "dist": "electron-builder --win nsis --x64",
    "install:local": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/install-local.ps1"
  },
  "devDependencies": {
    "electron": "^45.3.2",
    "electron-builder": "^26.0.12"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "build": {
    "appId": "app.zuricopilot.desktop",
    "productName": "ZuriCopilot",
    "copyright": "Copyright Zuri",
    "directories": {
      "output": "dist"
    },
    "files": [
      "electron/**/*",
      "features/**/*",
      "!**/*.test.js",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowElevation": false,
      "allowToChangeInstallationDirectory": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "ZuriCopilot",
      "runAfterFinish": false,
      "artifactName": "zuricopilot-desktop-${version}-setup.${ext}"
    }
  }
}