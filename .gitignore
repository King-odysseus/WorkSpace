# Scratch files from local agent runs: logs and minted sessions. The session
# file holds a live cookie and must never be staged.
.tmp-*

# Scratch screenshots from local agent runs. They land in the repo root and
# nothing in the app references them, so they only clutter status. Scoped to the
# root on purpose: the icons and help images the app actually ships live under
# public/ and must stay trackable.
/*.png

# Playwright MCP writes page snapshots and console logs here while a browser check runs.
.playwright-mcp/

# What a failed browser journey saw, kept for CI to collect as an artifact.
journey-failure-*.png
