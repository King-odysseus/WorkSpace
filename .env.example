WORKSPACE_DEBUG=true
WORKSPACE_SECRET_KEY=replace-with-a-long-random-secret
WORKSPACE_SECURE_SSL_REDIRECT=false
WORKSPACE_HSTS_SECONDS=0
WORKSPACE_HSTS_INCLUDE_SUBDOMAINS=false
WORKSPACE_HSTS_PRELOAD=false
WORKSPACE_ALLOWED_HOSTS=127.0.0.1,localhost
WORKSPACE_CSRF_TRUSTED_ORIGINS=http://127.0.0.1:5175,http://localhost:5175
# Leave WORKSPACE_DB_NAME empty for local SQLite. Set these for PostgreSQL.
WORKSPACE_DB_NAME=
WORKSPACE_DB_USER=
WORKSPACE_DB_PASSWORD=
WORKSPACE_DB_HOST=127.0.0.1
WORKSPACE_DB_PORT=5432
# Session lifetime in seconds (default 7 days). Rolls forward while a user is active.
WORKSPACE_SESSION_COOKIE_AGE=604800
# Login brute-force protection (django-axes). Lockout is per IP + username.
WORKSPACE_LOGIN_FAILURE_LIMIT=5
WORKSPACE_LOGIN_COOLOFF_MINUTES=15
# Dedicated filesystem path for authenticated, non-public screen captures.
WORKSPACE_PRIVATE_MEDIA_ROOT=private_media
# Optional company AI provider (kept server-side; never expose these in Vite)
AI_API_KEY=
AI_API_URL=https://api.openai.com/v1/chat/completions
AI_MODEL=gpt-4o-mini
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-3-5-haiku-latest
KIMI_API_KEY=
KIMI_API_URL=https://api.moonshot.cn/v1/chat/completions
KIMI_MODEL=moonshot-v1-8k
DEEPSEEK_API_KEY=
DEEPSEEK_API_URL=https://api.deepseek.com/chat/completions
DEEPSEEK_MODEL=deepseek-v4-flash
# Optional Cloudinary persistent upload storage
CLOUDINARY_URL=cloudinary://api_key:api_secret@cloud_name
# Transactional email via Brevo's SMTP relay (invitations, task/calendar reminders).
# Leave blank to use the console backend (prints emails instead of sending them).
# Get these from Brevo > SMTP & API > SMTP.
BREVO_SMTP_HOST=smtp-relay.brevo.com
BREVO_SMTP_PORT=587
BREVO_SMTP_LOGIN=
BREVO_SMTP_PASSWORD=
WORKSPACE_DEFAULT_FROM_EMAIL=WorkSpace <no-reply@yourdomain.com>
# Public URL of the deployed frontend, used to build links inside emails.
WORKSPACE_FRONTEND_BASE_URL=http://localhost:5173
# Google Sign-In: OAuth web client ID from https://console.cloud.google.com/apis/credentials
# Must also be set as VITE_GOOGLE_CLIENT_ID (same value) for the frontend build.
GOOGLE_OAUTH_CLIENT_ID=
# Web push (notification bubble even when the app/PWA is closed). Generate a keypair
# with `vapid --gen` (installed by pywebpush) and keep the private key secret.
# VAPID_PUBLIC_KEY must also be set as VITE_VAPID_PUBLIC_KEY for the frontend build.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_CLAIM_EMAIL=admin@yourdomain.com
# On Railway (single Dockerfile build), also set VITE_GOOGLE_CLIENT_ID and
# VITE_VAPID_PUBLIC_KEY as build-time variables so the frontend build picks them up
# (Railway service settings > Variables, marked "available at build time").
